# LandGuard NER - Python API
#
# Copy to .env in this directory:  cp .env.example .env
# The service key bypasses RLS - never commit the filled-in file.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Minutes between automatic scoring cycles. 0 disables the in-process
# scheduler (use Celery beat, cron, or POST /risk/run-cycle instead).
SCORING_INTERVAL_MINUTES=60

# Extra allowed CORS origins, comma separated.
CORS_ORIGINS=

# Optional - Celery/Redis, only needed for the distributed worker setup.
REDIS_URL=redis://localhost:6379/0

# Optional - Copernicus credentials for Sentinel ingestion (not yet implemented).
COPERNICUS_USER=
COPERNICUS_PASSWORD=
