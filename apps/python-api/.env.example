# ================================================
# Python FastAPI — Environment Variables
# Copy to .env and fill in your Supabase values
# ================================================

# ── Supabase (same project as Next.js) ──────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Cloudflare R2 ───────────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_BUCKET=landguard-ner

# ── Background Jobs (Redis for Celery) ──────────
# For local dev: install Redis via Docker (see guide)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Copernicus Hub (for Sentinel satellite data) ─
# Register free at: https://dataspace.copernicus.eu
SENTINEL_USER=your-copernicus-email
SENTINEL_PASSWORD=your-copernicus-password

# ── Shared secret with Next.js ──────────────────
API_SECRET=change-me-to-random-secret
