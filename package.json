{
  "name": "landguard-ner",
  "private": true,
  "version": "0.1.0",
  "description": "AI-Based Landslide Early Warning & Risk Monitoring System \u2014 North East India (SIH 26001)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:apply": "supabase db query --linked -f",
    "db:score": "supabase db query --linked 'SELECT * FROM compute_risk_scores();'"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
